[user]
name = Daniel Mellado
email = dmellado@redhat.com
[credential]
helper = cache --timeout=600
[core]
editor = vim
excludesfile = ~/.gitignore
[gitreview]
username = daniel-mellado
[push]
default = simple
[color]
ui = true
[alias]
nb = !git checkout --track $(git config branch.$(git rev-parse --abbrev-ref HEAD).remote)/$(git rev-parse --abbrev-ref HEAD) -b
cs = commit -s
csa = commit -s -a --amend
co = checkout
br = branch
sn = show --name-only
pr = pull-request
hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
st = status --short --show-stash
check-whitespace = !git diff-tree --check $(git hash-object -t tree /dev/null) HEAD
